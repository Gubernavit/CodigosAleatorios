CREATE TABLE JOGADOR(
    COD INTEGER PRIMARY KEY AUTOINCREMENT,
    NICKNAME VARCHAR(10),
    SENHA INT,
    PONTUACAO INT
);

ALTER TABLE JOGADOR ADD COLUMN LEVEL INT;

INSERT INTO JOGADOR (NICKNAME,SENHA,PONTUACAO)
    VALUES ("Jaison", 4512, 275);
    
DROP TABLE JOGADOR;

SELECT * FROM JOGADOR;

UPDATE JOGADOR SET LEVEL = 3 WHERE LEVEL IS NULL;

DELETE FROM JOGADOR WHERE LEVEL = 3;

SELECT NICKNAME FROM JOGADOR;

SELECT NICKNAME,PONTUACAO FROM JOGADOR WHERE PONTUACAO <210; 

SELECT NICKNAME, PONTUACAO FROM JOGADOR ORDER BY PONTUACAO DESC;

SELECT MIN (PONTUACAO), MAX (PONTUACAO) FROM JOGADOR;

SELECT AVG (PONTUACAO) FROM JOGADOR;

SELECT COUNT (*) FROM JOGADOR;

